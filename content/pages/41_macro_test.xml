<h2>4. 코드 블록 (Code)</h2>
<p>로컬 개발 환경 초기 설정 스크립트입니다.</p>

<ac:structured-macro ac:name="code" ac:schema-version="1">
  <ac:parameter ac:name="language">bash</ac:parameter>
  <ac:parameter ac:name="title">Git 초기 설정</ac:parameter>
  <ac:plain-text-body><![CDATA[# Git 사용자 정보 설정
git config --global user.name "홍길동"
git config --global user.email "gildong@nexusai.com"

# 기본 브랜치 main으로 설정
git config --global init.defaultBranch main

# 회사 내부 GitLab 접속 확인
ssh -T git@gitlab.nexusai.internal]]></ac:plain-text-body>
</ac:structured-macro>

<ac:structured-macro ac:name="code" ac:schema-version="1">
  <ac:parameter ac:name="language">bash</ac:parameter>
  <ac:parameter ac:name="title">VPN 연결 상태 확인</ac:parameter>
  <ac:plain-text-body><![CDATA[# VPN 연결 후 내부망 접근 확인
ping -c 3 vpn.nexusai.internal

# 사내 GitLab 접근 확인
curl -I https://gitlab.nexusai.internal/health]]></ac:plain-text-body>
</ac:structured-macro>
